# Omax Ai Android App - Environment Variables Example
# Copy this file to .env and fill in your actual values
# DO NOT commit the actual .env file to version control

# Signing Configuration for Release Builds
OMAX_KEY_ALIAS=omax
OMAX_KEY_PASSWORD=your_key_password_here
OMAX_KEYSTORE_PATH=/path/to/your/keystore.jks
OMAX_STORE_PASSWORD=your_store_password_here

# Usage:
# 1. Copy this file: cp .env.example .env
# 2. Fill in your actual values in .env
# 3. Source the file: source .env
# 4. Build release: ./gradlew assembleProductionStandardRelease
